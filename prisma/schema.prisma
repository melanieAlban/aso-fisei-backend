
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                String    @id @default(uuid())
  nombre            String
  usuario             String    @unique
  passwordHash      String
  activo            Boolean   @default(true)
  fechaUltimoAcceso DateTime?
  createdAt         DateTime  @default(now())

  roles             UsuarioRol[]
  permisosExtra     UsuarioPermisoExtra[] @relation("PermisosExtra")
  permisosOtorgados UsuarioPermisoExtra[] @relation("PermisosOtorgados")
  auditorias        Auditoria[]

  @@map("usuarios")
}

model Rol {
  id     String @id @default(uuid())
  nombre String @unique

  usuarios UsuarioRol[]
  permisos RolPermiso[]

  @@map("roles")
}

model Permiso {
  id          String @id @default(uuid())
  codigo      String @unique
  descripcion String

  roles         RolPermiso[]
  usuariosExtra UsuarioPermisoExtra[]

  @@map("permisos")
}

model UsuarioRol {
  usuarioId String
  rolId     String

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  rol     Rol     @relation(fields: [rolId], references: [id])

  @@id([usuarioId, rolId])
  @@map("usuario_rol")
}

model RolPermiso {
  rolId     String
  permisoId String

  rol     Rol     @relation(fields: [rolId], references: [id])
  permiso Permiso @relation(fields: [permisoId], references: [id])

  @@id([rolId, permisoId])
  @@map("rol_permiso")
}

model UsuarioPermisoExtra {
  id                   String   @id @default(uuid())
  usuarioId            String
  permisoId            String
  otorgadoPorUsuarioId String
  fecha                DateTime @default(now())

  usuario     Usuario @relation("PermisosExtra", fields: [usuarioId], references: [id])
  permiso     Permiso @relation(fields: [permisoId], references: [id])
  otorgadoPor Usuario @relation("PermisosOtorgados", fields: [otorgadoPorUsuarioId], references: [id])

  @@map("usuario_permiso_extra")
}

model Auditoria {
  id               String   @id @default(uuid())
  usuarioId        String?
  modulo           String
  accion           String
  registroAfectado String?
  valorAnterior    Json?
  valorNuevo       Json?
  fecha            DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("auditoria")
}

model Producto {
  id            String   @id @default(uuid())
  nombre        String
  costoUnitario Decimal  @db.Decimal(10, 2) @default(0)
  precioVenta   Decimal  @db.Decimal(10, 2)
  stockActual   Int      @default(0)
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())

  movimientos MovimientoInventario[]

  @@map("productos")
}

model MovimientoInventario {
  id         String                   @id @default(uuid())
  productoId String
  usuarioId  String
  tipo       TipoMovimientoInventario
  cantidad   Int
  motivo     String?
  gastoId    String?                  @unique
  fecha      DateTime                 @default(now())

  producto Producto @relation(fields: [productoId], references: [id])
  gasto    Gasto?   @relation(fields: [gastoId], references: [id])

  @@map("movimientos_inventario")
}

enum TipoMovimientoInventario {
  COMPRA
  VENTA
  PERDIDA
  AJUSTE
}

model Gasto {
  id                      String      @id @default(uuid())
  usuarioId               String
  descripcion             String
  monto                   Decimal     @db.Decimal(10, 2)
  categoria               String
  fuentePago              FuentePago
  moneda                  MetodoPago?
  generadoAutomaticamente Boolean     @default(false)
  estado                  EstadoGasto @default(ACTIVO)
  motivoAnulacion         String?
  usuarioAnulacionId      String?
  fecha                   DateTime    @default(now())

  movimientoInventario MovimientoInventario?
  deudas               Deuda[]

  @@map("gastos")
}

enum FuentePago {
  EFECTIVO_CAJA
  FONDO_GENERAL
}

enum EstadoGasto {
  ACTIVO
  ANULADO
}

model ConfiguracionSistema {
  clave String @id
  valor String

  @@map("configuracion_sistema")
}

model Caja {
  id                   String     @id @default(uuid())
  usuarioAperturaId    String
  usuarioCierreId      String?
  fondoInicialEfectivo Decimal    @db.Decimal(10, 2)
  estado               EstadoCaja @default(ABIERTA)
  fechaApertura        DateTime   @default(now())
  fechaCierre          DateTime?

  ventas Venta[]
  arqueo ArqueoCaja?

  @@map("cajas")
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

model ArqueoCaja {
  id                         String                    @id @default(uuid())
  cajaId                     String                    @unique
  usuarioId                  String
  efectivoEsperado           Decimal                   @db.Decimal(10, 2)
  efectivoContado            Decimal                   @db.Decimal(10, 2)
  transferenciaEsperado      Decimal                   @db.Decimal(10, 2)
  transferenciaContado       Decimal                   @db.Decimal(10, 2)
  montoRetiradoEfectivo      Decimal                   @db.Decimal(10, 2)
  montoRetiradoTransferencia Decimal                   @db.Decimal(10, 2)
  montoDejadoFondoCambio     Decimal                   @db.Decimal(10, 2)
  clasificacionDiferencia    ClasificacionDiferencia?
  fecha                      DateTime                  @default(now())

  caja Caja @relation(fields: [cajaId], references: [id])

  @@map("arqueos_caja")
}

enum ClasificacionDiferencia {
  GANANCIA
  PERDIDA
  PENDIENTE
}

model Venta {
  id         String   @id @default(uuid())
  usuarioId  String
  cajaId     String
  metodoPago MetodoPago
  total      Decimal  @db.Decimal(10, 2)
  fecha      DateTime @default(now())

  caja    Caja           @relation(fields: [cajaId], references: [id])
  detalle DetalleVenta[]

  @@map("ventas")
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
}

model DetalleVenta {
  id                 String              @id @default(uuid())
  ventaId            String
  productoId         String
  cantidad           Int
  precioUnitario     Decimal             @db.Decimal(10, 2)
  esAlquiler         Boolean             @default(false)
  estadoAlquiler     EstadoAlquiler?
  estado             EstadoDetalleVenta  @default(ACTIVO)
  motivoAnulacion    String?
  usuarioAnulacionId String?

  venta Venta @relation(fields: [ventaId], references: [id])

  @@map("detalle_venta")
}

enum EstadoAlquiler {
  DEVUELTO
  PENDIENTE
}

enum EstadoDetalleVenta {
  ACTIVO
  ANULADO
}

model MovimientoFondoGeneral {
  id                            String               @id @default(uuid())
  usuarioId                     String
  tipo                          TipoMovimientoFondo
  monto                         Decimal              @db.Decimal(10, 2)
  metodoPago                    MetodoPago
  saldoResultanteEfectivo       Decimal              @db.Decimal(10, 2)
  saldoResultanteTransferencia  Decimal              @db.Decimal(10, 2)
  referenciaId                  String?
  descripcion                   String?
  fecha                         DateTime             @default(now())

  @@map("movimientos_fondo_general")
}

enum TipoMovimientoFondo {
  RETIRO_CAJA
  GASTO
  AJUSTE_INICIAL
  UTILIDAD_EVENTO
  ABONO_DEUDA_RECIBIDO
  ABONO_DEUDA_PAGADO
}

model SaldoGlobal {
  id                 Int     @id @default(1)
  saldoEfectivo      Decimal @db.Decimal(10, 2) @default(0)
  saldoTransferencia Decimal @db.Decimal(10, 2) @default(0)

  @@map("saldo_global")
}

model Deuda {
  id            String      @id @default(uuid())
  usuarioId     String
  gastoId       String?
  tipo          TipoDeuda
  contraparte   String
  montoTotal    Decimal     @db.Decimal(10, 2)
  montoAbonado  Decimal     @db.Decimal(10, 2) @default(0)
  estado        EstadoDeuda @default(PENDIENTE)
  fechaRegistro DateTime    @default(now())

  gasto  Gasto?       @relation(fields: [gastoId], references: [id])
  abonos AbonoDeuda[]

  @@map("deudas")
}

enum TipoDeuda {
  POR_COBRAR
  POR_PAGAR
}

enum EstadoDeuda {
  PENDIENTE
  PARCIAL
  CANCELADA
}

model AbonoDeuda {
  id         String     @id @default(uuid())
  deudaId    String
  usuarioId  String
  monto      Decimal    @db.Decimal(10, 2)
  metodoPago MetodoPago
  fecha      DateTime   @default(now())

  deuda Deuda @relation(fields: [deudaId], references: [id])

  @@map("abonos_deuda")
}

model Evento {
  id          String       @id @default(uuid())
  nombre      String
  presupuesto Decimal?     @db.Decimal(10, 2)
  estado      EstadoEvento @default(ACTIVO)
  fechaInicio DateTime
  fechaFin    DateTime?
  fechaCierre DateTime?

  tiposEntrada TipoEntrada[]
  ingresos     IngresoEvento[]
  gastos       GastoEvento[]

  @@map("eventos")
}

enum EstadoEvento {
  ACTIVO
  CERRADO
}

model TipoEntrada {
  id            String  @id @default(uuid())
  eventoId      String
  nombre        String
  precio        Decimal @db.Decimal(10, 2)
  cantidadTotal Int

  evento       Evento               @relation(fields: [eventoId], references: [id])
  asignaciones AsignacionEntradas[]

  @@map("tipos_entrada")
}

model AsignacionEntradas {
  id                String      @id @default(uuid())
  tipoEntradaId     String
  usuarioRegistroId String
  nombreReferencia  String
  cantidadAsignada  Int
  cantidadVendida   Int         @default(0)
  cantidadDevuelta  Int         @default(0)
  dineroRecibido    Decimal     @db.Decimal(10, 2) @default(0)
  metodoPago        MetodoPago?
  fecha             DateTime    @default(now())

  tipoEntrada TipoEntrada @relation(fields: [tipoEntradaId], references: [id])

  @@map("asignaciones_entradas")
}

model IngresoEvento {
  id          String     @id @default(uuid())
  eventoId    String
  usuarioId   String
  descripcion String
  monto       Decimal    @db.Decimal(10, 2)
  metodoPago  MetodoPago
  fecha       DateTime   @default(now())

  evento Evento @relation(fields: [eventoId], references: [id])

  @@map("ingresos_evento")
}

model GastoEvento {
  id          String     @id @default(uuid())
  eventoId    String
  usuarioId   String
  descripcion String
  monto       Decimal    @db.Decimal(10, 2)
  metodoPago  MetodoPago
  fecha       DateTime   @default(now())

  evento Evento @relation(fields: [eventoId], references: [id])

  @@map("gastos_evento")
}
