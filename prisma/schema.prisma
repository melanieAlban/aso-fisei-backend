
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                String    @id @default(uuid())
  nombre            String
  usuario             String    @unique
  passwordHash      String
  activo            Boolean   @default(true)
  fechaUltimoAcceso DateTime?
  createdAt         DateTime  @default(now())

  roles             UsuarioRol[]
  permisosExtra     UsuarioPermisoExtra[] @relation("PermisosExtra")
  permisosOtorgados UsuarioPermisoExtra[] @relation("PermisosOtorgados")
  auditorias        Auditoria[]

  @@map("usuarios")
}

model Rol {
  id     String @id @default(uuid())
  nombre String @unique

  usuarios UsuarioRol[]
  permisos RolPermiso[]

  @@map("roles")
}

model Permiso {
  id          String @id @default(uuid())
  codigo      String @unique
  descripcion String

  roles         RolPermiso[]
  usuariosExtra UsuarioPermisoExtra[]

  @@map("permisos")
}

model UsuarioRol {
  usuarioId String
  rolId     String

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  rol     Rol     @relation(fields: [rolId], references: [id])

  @@id([usuarioId, rolId])
  @@map("usuario_rol")
}

model RolPermiso {
  rolId     String
  permisoId String

  rol     Rol     @relation(fields: [rolId], references: [id])
  permiso Permiso @relation(fields: [permisoId], references: [id])

  @@id([rolId, permisoId])
  @@map("rol_permiso")
}

model UsuarioPermisoExtra {
  id                   String   @id @default(uuid())
  usuarioId            String
  permisoId            String
  otorgadoPorUsuarioId String
  fecha                DateTime @default(now())

  usuario     Usuario @relation("PermisosExtra", fields: [usuarioId], references: [id])
  permiso     Permiso @relation(fields: [permisoId], references: [id])
  otorgadoPor Usuario @relation("PermisosOtorgados", fields: [otorgadoPorUsuarioId], references: [id])

  @@map("usuario_permiso_extra")
}

model Auditoria {
  id               String   @id @default(uuid())
  usuarioId        String?
  modulo           String
  accion           String
  registroAfectado String?
  valorAnterior    Json?
  valorNuevo       Json?
  fecha            DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("auditoria")
}
